# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 git 에 올리지 마세요)

# Gmail 계정 + 앱 비밀번호(App Password, 16자리)
# 발급: Google 계정 > 보안 > 2단계 인증 사용 설정 > 앱 비밀번호
GMAIL_USER=abcd@gmail.com
GMAIL_APP_PASSWORD=abcd

# 메일 발신자 표시 이름
MAIL_FROM_NAME=Stock Watchlist

# 인증 링크에 사용할 앱 주소 (배포 시 실제 도메인으로 변경)
APP_BASE_URL=http://localhost:8501

# 인증 링크 유효 시간(시간 단위)
TOKEN_TTL_HOURS=24

# 메일 발송 실패 시 인증 링크를 화면에 표시(개발용). 운영에서는 false 권장
DEV_SHOW_LINK=true

# DB 파일 위치. 평소에는 주석 그대로 두세요(코드 옆 stock_app.db 사용).
# 주의: "STOCK_APP_DB=" 처럼 빈 값으로 두면 docker run --env-file 이 빈 값을 넘겨
#       Dockerfile 의 /data 설정을 덮어쓰고, DB 가 볼륨 밖에 생겨 데이터가 사라집니다.
# STOCK_APP_DB=/data/stock_app.db
